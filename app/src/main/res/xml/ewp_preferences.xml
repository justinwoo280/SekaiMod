<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="serverPort"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_person_24"
            app:key="uuid"
            app:title="@string/uuid" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="serverPublicKey"
            app:summary="EWP/v2.3: base64 Ed25519 server signing public key (from `sing-box generate ewp-keypair`)"
            app:title="Server Public Key" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="serverId"
            app:summary="EWP/v2.3: must match the server's server_id exactly"
            app:title="Server ID" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="routeEpoch"
            app:summary="EWP/v2.3: 0 unless the operator rotates route tags"
            app:title="Route Epoch" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/transport_settings">
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="tcp"
            app:entries="@array/networks_value"
            app:entryValues="@array/networks_value"
            app:icon="@drawable/ic_baseline_multiple_stop_24"
            app:key="type"
            app:title="@string/v_type"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_domain_24"
            app:key="host"
            app:title="@string/host"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_format_align_left_24"
            app:key="path"
            app:title="@string/path"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverXhttpCategory"
        app:title="@string/xhttp_settings">
        <SwitchPreference
            app:icon="@drawable/ic_baseline_http_24"
            app:key="xhttpBrowser"
            app:summary="@string/xhttp_browser_summary"
            app:title="@string/xhttp_browser" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/xhttp_mode_entry"
            app:entryValues="@array/xhttp_mode_value"
            app:key="xhttpMode"
            app:title="@string/xhttp_mode"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="xhttpModeDefaultsInfo"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/xhttp_mode_defaults_title" />
        <EditTextPreference
            app:key="xhttpPaddingBytes"
            app:title="@string/xhttp_padding_bytes"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverXhttpXmuxCategory"
        app:title="@string/xhttp_xmux_settings">
        <EditTextPreference
            app:key="xhttpXmuxMaxConcurrency"
            app:title="@string/xhttp_xmux_max_concurrency"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="xhttpXmuxMaxConnections"
            app:title="@string/xhttp_xmux_max_connections"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="xhttpXmuxCMaxReuseTimes"
            app:title="@string/xhttp_xmux_c_max_reuse_times"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="xhttpXmuxHMaxRequestTimes"
            app:title="@string/xhttp_xmux_h_max_request_times"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="xhttpXmuxHMaxReusableSecs"
            app:title="@string/xhttp_xmux_h_reusable_secs"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="xhttpXmuxHKeepAlivePeriod"
            app:title="@string/xhttp_xmux_h_keep_alive_period"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverSecurityCategory"
        app:title="@string/security_settings">
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="sni"
            app:title="@string/sni"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="alpn"
            app:title="@string/alpn"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="certificates"
            app:title="@string/certificates"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_notification_enhanced_encryption"
            app:key="allowInsecure"
            app:title="@string/allow_insecure" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="tlsFragment"
            app:summary="Split TLS ClientHello across packets"
            app:title="TLS Fragment" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="tlsRecordFragment"
            app:summary="Split TLS records (more aggressive)"
            app:title="TLS Record Fragment" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverTlsCamouflageCategory"
        app:summary="REALITY and ECH are mutually exclusive — only one can be active"
        app:title="@string/tls_camouflage_settings">
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/utls_fingerprint_entry"
            app:entryValues="@array/utls_fingerprint_entry"
            app:icon="@drawable/ic_baseline_fingerprint_24"
            app:key="utlsFingerprint"
            app:title="@string/utls_fingerprint"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="realityPubKey"
            app:title="REALITY Public Key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_grid_3x3_24"
            app:key="realityShortId"
            app:title="REALITY Short ID"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverECHCategory"
        app:summary="Disabled when REALITY is configured (mutually exclusive)"
        app:title="@string/ech_settings">
        <SwitchPreference
            app:icon="@drawable/ic_notification_enhanced_encryption"
            app:key="enableECH"
            app:title="@string/enable_ech" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="echConfig"
            app:title="@string/ech_config"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="echQueryServerName"
            app:summary="FQDN used to fetch ECH config via HTTPS RR (decouples from inner SNI)"
            app:title="ECH Query Server Name" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverMuxCategory"
        app:title="@string/mux_settings">
        <SwitchPreference
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="enableMux"
            app:title="@string/enable_mux" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_view_list_24"
            app:key="muxType"
            app:title="@string/mux_type"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_multiple_stop_24"
            app:key="muxConcurrency"
            app:title="@string/mux_concurrency"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="muxPadding"
            app:title="@string/mux_padding" />
    </PreferenceCategory>

</PreferenceScreen>
